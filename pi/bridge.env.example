# ChessDS bridge settings. Copy to bridge.env and fill in.

# Lichess personal API token with the board:play scope. Create one here:
# https://lichess.org/account/oauth/token/create?scopes[]=board:play&scopes[]=challenge:write&description=ChessDS
LICHESS_TOKEN=lip_xxxxxxxxxxxxxxxxxxxx

# Shared secret: the DS must send the same value (secret= in chessds.ini).
CHESSDS_SECRET=changeme

# Where the bridge listens for the DS.
CHESSDS_BIND=0.0.0.0
CHESSDS_PORT=5555

# Lichess usernames listed in the DS "Challenge a friend" menu, comma separated.
CHESSDS_FRIENDS=
