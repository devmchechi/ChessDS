# Settings for tools/setup_hotspot.sh. Copy to hotspot.env and fill in.

# Network name the DS joins (ssid= in chessds.ini).
HOTSPOT_SSID=ChessDS

# WPA2 password (password= in chessds.ini), 8-63 characters. Works for a DSi or
# 3DS running ChessDS in DSi mode. Leave empty for an open network, which a DS
# or DS Lite needs (then also add the firewall from docs/PI_SETUP.md).
HOTSPOT_PASSWORD=
